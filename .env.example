# Copier en .env pour personnaliser : cp .env.example .env
# Sans .env, les valeurs par défaut du docker-compose.yml sont utilisées.

# Versions des images (épinglées : jamais de "latest")
NGINX_VERSION=1.28.0-alpine
MYSQL_VERSION=8.4
API_VERSION=1.0.0

# Base de données
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=adresses
MYSQL_USER=app
MYSQL_PASSWORD=app
